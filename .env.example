# Neon PostgreSQL connection string (use the pooled -pooler host for serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# 32+ byte random secret used to sign admin session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Seed credentials for the first admin account (used only by prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Astrix Admin"

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
