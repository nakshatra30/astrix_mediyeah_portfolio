generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN")
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  media Media[]

  @@index([email])
}

model Service {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  shortDescription String
  description      String
  icon             String   @default("sparkles")
  features         String[] @default([])
  imageUrl         String?
  price            String?
  order            Int      @default(0)
  featured         Boolean  @default(false)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projects Project[]

  @@index([published, order])
  @@index([slug])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  client      String
  category    String
  summary     String
  description String
  imageUrl    String?
  gallery     String[] @default([])
  results     String[] @default([])
  liveUrl     String?
  year        Int?
  order       Int      @default(0)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  serviceId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  testimonials Testimonial[]

  @@index([published, featured, order])
  @@index([category])
  @@index([serviceId])
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  clientRole String
  company    String?
  content    String
  rating     Int      @default(5)
  avatarUrl  String?
  projectId  String?
  order      Int      @default(0)
  featured   Boolean  @default(false)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([published, order])
  @@index([projectId])
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

model ContactEnquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  message   String
  status    EnquiryStatus @default(NEW)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  value     String   @db.Text
  group     String   @default("general")
  type      String   @default("text")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

model Media {
  id           String   @id @default(cuid())
  name         String
  url          String
  alt          String?
  type         String   @default("image")
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy Admin? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
